     const end = ai + 1 < anchors.length ? anchors[ai + 1].start : start + 4000;
     const card = html.slice(start, end);
 
-    // DEBUG: For Lotto Cup, print h3 raw HTML for first 5 cards
-    if (isLottoCup && dbgLotto < 5) {
-      const h3dbg = card.match(/<h3[^>]*>([\s\S]*?)<\/h3>/i);
-      const pdbg  = card.match(/<p[^>]*>(\d{2}\.\d{2}\.\d{4})<\/p>/);
-      const rawH3 = h3dbg ? h3dbg[0].substring(0, 200) : "NO_H3";
-      console.log(`[DBG-LOTTO-${dbgLotto}] gid=${gameId} date="${pdbg ? pdbg[1] : "?"}" h3raw="${rawH3}"`);
-      dbgLotto++;
-    }
-
     // Home team: first <strong> inside teamInnerParapraph (not Second)
     const homeM = card.match(/teamInnerParapraph"[\s\S]*?<strong>([\s\S]*?)<\/strong>/i);
     // Away team: first <strong> inside teamInnerParapraphSecond
@@ -363,17 +352,22 @@ function parseGamesHtml(html, ranking, leagueName) {
     if (/^bye\b/i.test(homeName) || /^bye\b/i.test(awayName)) continue;
 
     // Score from <h3>: "26 : 25" = played, " - : - " = scheduled
-    const h3M   = card.match(/<h3[^>]*>([\s\S]*?)<\/h3>/i);
-    const h3    = h3M ? stripText(h3M[1]) : "";
+    // Clubee admins often don't enter scores — fall back to date-based detection
