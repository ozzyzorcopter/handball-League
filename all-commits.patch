+function parseGamesHtml(html, ranking) {
   const teamNames = ranking.map(r => r.name);
   const nameIdx   = new Map(teamNames.map((n, i) => [n.toLowerCase(), i]));
 
@@ -335,22 +335,11 @@ function parseGamesHtml(html, ranking, leagueName) {
